# NaijaBiz AI: ML Service Environment Variables

# Shared secret between Backend and ML Service (backend must send this in the X-API-Key header)
ML_API_KEY=Abiodun5$

# Backend API
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=

# LLM on Colab:
LLM_BACKEND=openai_compatible
# PASTE YOUR CLOUDFLARE URL BELOW (from the Colab cell that prints LLM_BASE_URL = ...):
LLM_BASE_URL=https://sport-smilies-bits-tuner.trycloudflare.com/v1

LLM_API_KEY=Abiodun5$
LLM_MODEL=NCAIR1/N-ATLaS

# Speech:
ASR_BACKEND=mock

# Receipt OCR: mock | tesseract | easyocr
OCR_BACKEND=easyocr

MIN_CONFIDENCE=0.6
